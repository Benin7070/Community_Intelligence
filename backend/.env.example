# =========================================================================
# Community Intelligence Platform - Backend Environment Template
# =========================================================================

# Database Configuration (Supabase PostgreSQL)
SUPABASE_DB_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-region.pooler.supabase.com:6543/postgres

# Application & Security Settings
APP_NAME=Community Intelligence Platform
ENVIRONMENT=production
PORT=8000
SECRET_KEY=generate_a_secure_random_string_here_min_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Security & CORS Configuration
FRONTEND_URL=https://coin.aether70.me
ALLOWED_ORIGINS=https://coin.aether70.me,https://www.coin.aether70.me

# LLM Providers Configuration
DEFAULT_LLM_PROVIDER=openai
OPENAI_API_KEY=sk-proj-your-openai-api-key
GEMINI_API_KEY=AIzaSy-your-google-gemini-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# Community Data Source APIs
STACK_EXCHANGE_API_KEY=
GITHUB_TOKEN=

# SMTP2GO Email Service
SMTP_HOST=mail.smtp2go.com
SMTP_PORT=2525
SMTP2GO_API_KEY=api-your-smtp2go-key
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=Community Intelligence Platform
